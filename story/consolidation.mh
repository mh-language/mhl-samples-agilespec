import {SpecAuthor} from "../lib/agents.mh"
import {ConsolidationPrompt} from "../lib/prompts.mh"
import {Specs, ReviewAction, ConsolidationReview} from "../lib/contracts.mh"

// Fase 3: consolidação das specs globais, Definition of Done e conclusão.
// Refazer só esta fase (outra proposta de consolidação, sem revisar código):
// `mhl run story.mh --session ... --resume --from Consolidation`.
partial workflow AgileSpecStory stage Consolidation {
    // Estado desta fase apenas.
    var consolidated = {}
    var consolidation_problems = []

    var completion_before = {}
    var completion_after = {}

    step DraftConsolidation timeout 12m {
        Specs.same(project_folder, project)
        Specs.same(story_folder, story)

        var data = json.stringify({
            project_dir,
            story_id,
            project,
            story,
            implementation,
            verification
        })

        var raw = SpecAuthor.run(repo: project_dir, prompt: ConsolidationPrompt(data: data))

        var proposal = Specs.consolidation(raw, project, story, story_id)

        self.consolidated = proposal.files
        self.consolidation_problems = proposal.problems

        Specs.same(project_folder, project)
        Specs.same(story_folder, story)

        Specs.artifact(review_folder, "consolidation.json", {
            before: project,
            files: consolidated,
            problems: consolidation_problems
        })
    }

    step ApproveConsolidation {
        var problems = ""

        if (!consolidation_problems.is_empty()) {
            problems = "A consolidação apontou: ${consolidation_problems.join("; ")}. " +
                "Peça uma revisão, rejeite, ou refaça a consolidação com --from Consolidation. "
        }

        var d = pause(
            "${review_notice}${problems}Revise ${review_folder}/consolidation.json e a Definition of Done. " +
            "Retome com --decision: '{\"action\": \"Approve\", \"dod_confirmed\": true}' " +
            "somente após atender todos os critérios, " +
            "'{\"action\": \"Revise\", \"feedback\": \"...\", \"revise_specs\": false}' " +
            "ou '{\"action\": \"Reject\"}'.",
            decision: ConsolidationReview
        )

        self.review_notice = ""

        if (d.action == ReviewAction.Reject) {
            goto Rejected
        }

        if (d.action == ReviewAction.Revise) {
            var note = d.get("feedback", "")

            if (note.trim().is_empty()) {
                self.review_notice = "Uma revisão exige feedback. "

                goto ApproveConsolidation
            }

            self.feedback = note
            self.revise_specs = d.get("revise_specs", false)

            goto PrepareRevision
        }

        // An approval the consolidation cannot take asks again, saying why.
        if (!consolidation_problems.is_empty()) {
            self.review_notice = "Não é possível aprovar uma consolidação com problemas. "

            goto ApproveConsolidation
        }

        if (!d.get("dod_confirmed", false)) {
            self.review_notice = "Confirme todos os critérios da Definition of Done (dod_confirmed: true). "

            goto ApproveConsolidation
        }
    }

    step PublishConsolidation {
        Specs.same(story_folder, story)

        Specs.apply(project_folder, project, consolidated)

        self.completion_before = {"backlog.md": consolidated["backlog.md"]}
        self.completion_after = {"backlog.md": Specs.finish(consolidated["backlog.md"], story_id)}
    }

    step MarkDone {
        Specs.apply(project_folder, completion_before, completion_after)

        Specs.artifact(review_folder, "done.json", {
            story_id,
            attempt,
            spec_round,
            verification,
            manual_validation_approved: true,
            consolidation_approved: true,
            dod_confirmed: true
        })

        self.status = "done"

        goto Done
    }

    step Done {
        complete()
    }
}
