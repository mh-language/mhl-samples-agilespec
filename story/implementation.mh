import {StoryImplementer} from "../lib/agents.mh"
import {ImplementationPrompt} from "../lib/prompts.mh"
import {Specs, Verification, ReviewAction, CodeReview} from "../lib/contracts.mh"

// Fase 2: tentativas de implementação, verificação e revisão humana.
// A revisão encaminha para PrepareRevision ou Rejected, no fragmento de
// entrada (story.mh): eles valem para a história inteira, não para esta fase.
partial workflow AgileSpecStory stage Implementation {
    step StartAttempt {
        self.attempt = attempt + 1
    }

    step Implement timeout 35m {
        Specs.same(project_folder, project)
        Specs.same(story_folder, story)

        var data = json.stringify({
            project_dir,
            story_id,
            project,
            story,
            attempt,
            feedback,
            verify_command
        })

        var raw = StoryImplementer.run(repo: project_dir, prompt: ImplementationPrompt(data: data))

        self.implementation = Specs.report(raw)

        Specs.same(project_folder, project)
        Specs.same(story_folder, story)

        Specs.artifact(review_folder, "implementation-${attempt}.json", implementation)
    }

    step Verify timeout 12m {
        self.verification = Verification.execute(project_dir, verify_command)

        Specs.same(project_folder, project)
        Specs.same(story_folder, story)

        Specs.artifact(review_folder, "verification-${attempt}.json", verification)
    }

    step ReviewImplementation {
        var d = pause(
            "${review_notice}Revise código, implementation-${attempt}.json e " +
            "verification-${attempt}.json em ${review_folder}. Valide manualmente. " +
            "Retome com --decision: '{\"action\": \"Approve\"}', " +
            "'{\"action\": \"Revise\", \"feedback\": \"...\", \"revise_specs\": false}' " +
            "ou '{\"action\": \"Reject\"}'.",
            decision: CodeReview
        )

        self.review_notice = ""

        if (d.action == ReviewAction.Reject) {
            goto Rejected
        }

        if (d.action == ReviewAction.Revise) {
            var note = d.get("feedback", "")

            if (note.trim().is_empty()) {
                self.review_notice = "Uma revisão exige feedback. "

                goto ReviewImplementation
            }

            self.feedback = note
            self.revise_specs = d.get("revise_specs", false)

            goto PrepareRevision
        }

        // An approval this attempt cannot take asks again, saying why.
        if (!verification.passed) {
            self.review_notice = "Não é possível aprovar: os testes automatizados falharam; peça uma revisão. "

            goto ReviewImplementation
        }

        if (implementation.status != "ready") {
            self.review_notice = "Não é possível aprovar: a implementação está bloqueada; peça uma revisão com esclarecimento. "

            goto ReviewImplementation
        }

        goto Consolidation
    }
}
