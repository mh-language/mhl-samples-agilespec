import {SpecAuthor} from "lib/agents.mh"
import {InceptionPrompt} from "lib/prompts.mh"
import {Specs} from "lib/contracts.mh"

export workflow AgileSpecInception {
    description: "Prepara as cinco especificações globais leves e aguarda aprovação humana antes de publicá-las."

    /// project_dir: path to the AgileSpec project folder, which must exist and contain a valid AgileSpec project structure.
    input project_dir: string
    /// brief: a product brief and prioritized story backlog, which must be non-empty —
    /// the text itself, or the path of a file holding it (relative to where mhl runs,
    /// e.g. examples/podlite-brief.txt).
    input brief: string

    // The brief's text: brief itself, or the file it names.
    var brief_text = ""

    var project_folder = ""
    var review_folder = ""

    var original = {}
    var proposed = {}

    output: {
        project_dir,
        project_specs: project_folder,
        review_artifacts: review_folder
    }

    step ReadContext {
        if (!dir.exists(project_dir)) {
            fail("project_dir must be an existing directory")
        }

        // A path is one short line naming a file; anything else is the text.
        var path = brief.trim()
        self.brief_text = brief
        if (!path.contains("\n") && path.size() < 256 && fs.exists(path) && !dir.exists(path)) {
            self.brief_text = fs.read(path)
        }

        if (brief_text.trim().is_empty()) {
            fail("A product brief and prioritized story backlog are required")
        }

        self.project_folder = fs.join(project_dir, "AgileSpec", "project")
        self.review_folder = fs.join(project_dir, ".agilespec-mhl", "inception")

        self.original = Specs.read(project_folder, Specs.project_names(), false)
    }

    step DraftInception timeout 12m {
        var data = json.stringify({project_dir, brief: brief_text, existing_project: original})

        var raw = SpecAuthor.run(repo: project_dir, prompt: InceptionPrompt(data: data))

        self.proposed = Specs.documents(raw, Specs.project_names(), Specs.project_names())
        Specs.same(project_folder, original)

        Specs.artifact(review_folder, "project-proposal.json", {before: original, files: proposed})
    }

    step ApproveInception {
        /// approved: marque para aprovar a proposta e publicar os cinco documentos em
        /// AgileSpec/project; deixe desmarcado para descartá-la sem alterar nada.
        var approved = pause(
            "Revise ${review_folder}/project-proposal.json. " +
            "Retome com --decision true para aprovar a iniciação, ou false para descartá-la.",
            decision: bool
        )

        if (!approved) {
            break "Inception discarded: start a new session with a corrected brief"
        }
    }

    step PublishProjectSpecs {
        Specs.apply(project_folder, original, proposed)
    }

    step Done {
        complete()
    }
}
