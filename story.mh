import {Specs} from "lib/contracts.mh"

import "story/specification.mh"
import "story/implementation.mh"
import "story/consolidation.mh"

export partial workflow AgileSpecStory {
    description: "Entrega uma história AgileSpec com especificação aprovada, implementação, testes, revisão humana e consolidação."

    // Inputs da história inteira, pedidos ao iniciar o run. Cada fase declara
    // os seus no próprio fragmento: Specification as opções das specs,
    // Implementation o comando de testes, que o run só pede ao entrar nela
    // (`awaiting_inputs`), depois das specs aprovadas.

    /// project_dir: path to the AgileSpec project folder, which must exist and contain a valid AgileSpec project structure.
    input project_dir: string
    /// story_id: the story number to be delivered, which must be a pending story in the project backlog.
    input story_id: string
    /// max_attempts: the maximum number of times a story can be revised, which must be an integer between 1 and 20.
    input max_attempts: number = 3

    var project_folder = ""
    var story_folder = ""
    var review_folder = ""

    var project = {}
    var story_before = {}
    var story = {}

    var spec_round = 1
    var attempt = 0

    var implementation = {}
    var verification = {}

    // Set from the human gates' decisions (`pause(..., decision: T)`).
    var feedback = ""
    var revise_specs = false
    // Why a gate asks again: a decision it could not accept, shown in its message.
    var review_notice = ""

    var status = "in_progress"

    output: {
        story_id,
        status,
        attempts: attempt,
        specification_round: spec_round,
        implementation,
        verification,
        review_artifacts: review_folder
    }

    entry step LoadContext {
        Specs.story_id(story_id)

        if (!dir.exists(project_dir)) {
            fail("project_dir must be an existing directory")
        }

        if (max_attempts < 1 || max_attempts > 20 || !"${max_attempts}".matches("[1-9][0-9]*")) {
            fail("max_attempts must be an integer between 1 and 20")
        }

        self.project_folder = fs.join(project_dir, "AgileSpec", "project")
        self.story_folder = fs.join(project_dir, "AgileSpec", "stories", "story${story_id}")
        self.review_folder = fs.join(project_dir, ".agilespec-mhl", "story${story_id}")

        self.project = Specs.read(project_folder, Specs.project_names(), true)
        Specs.pending(project["backlog.md"], story_id)

        self.story_before = Specs.read(
            story_folder,
            ["acceptance.md", "design.md", "views.md", "tables.md"],
            false
        )

        goto Specification
    }

    // Os dois passos abaixo valem para a história inteira, não para uma fase:
    // ficam fora de qualquer stage, e as fases chegam a eles pelo nome.

    // Uma revisão (pedida na implementação ou na consolidação) volta à fase
    // certa: especificação, se as specs mudam, senão implementação.
    step PrepareRevision {
        if (feedback.trim().is_empty()) {
            fail("Revision requires human feedback")
        }

        if (attempt >= max_attempts) {
            fail("Revision limit reached (${max_attempts}); start a new session after reviewing scope")
        }

        if (revise_specs) {
            self.spec_round = spec_round + 1
            self.story_before = story

            goto Specification
        }

        goto Implementation
    }

    step Rejected {
        self.status = "rejected"

        break "Story ${story_id} rejected by human review; backlog remains pending"
    }
}
